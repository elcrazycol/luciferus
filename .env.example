# ── Инфраструктура (docker compose) ───────────────────────────────
POSTGRES_USER=luciferus
POSTGRES_PASSWORD=luciferus
POSTGRES_DB=luciferus
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
REDIS_PORT=56379

# ── Приложение ────────────────────────────────────────────────────
DATABASE_URL=postgres://luciferus:luciferus@localhost:55432/luciferus
REDIS_URL=redis://localhost:56379
PORT=3001

# Как портал обращается к API. В докере это внутренний адрес сервиса.
API_URL=http://localhost:3001

# Публичный адрес API — его получают игры в хендшейке и ходят по нему напрямую.
# В проде это тот же домен, что и портал, если прокси маршрутизирует /v1/* в API.
PUBLIC_API_URL=http://localhost:3001

NEXT_PUBLIC_API_URL=http://localhost:3001

# Публичный адрес портала. Игры получают его в хендшейке.
# В локалке — http://localhost:3000, в проде — https://ваш-домен
PORTAL_URL=http://localhost:3000

# Секрет для подписи игровых сессионных токенов (фаза 2).
# Сгенерировать: openssl rand -hex 32
GAME_SESSION_SECRET=dev-only-change-me

# ── Экономика ─────────────────────────────────────────────────────
SIGNUP_BONUS=250
RELOAD_BONUS=100
RELOAD_COOLDOWN_MINUTES=15

# Адрес эталонной игры. Локально — её dev-сервер, в проде портал отдаёт её сам:
# EXAMPLE_GAME_URL=https://ваш-домен/example-game/
EXAMPLE_GAME_URL=http://localhost:4000/

# ── Разработка ────────────────────────────────────────────────────
NODE_ENV=development
# Пропускать модерацию при регистрации игр (удобно локально)
AUTO_APPROVE_GAMES=true
# Сидированные боты в лобби, чтобы лента выигрышей выглядела живой
LOBBY_BOTS=true
