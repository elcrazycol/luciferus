{
  "name": "luciferus-casinos",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open-source fake-casino platform: bring your own game, play with CrazyBucks, no real money involved",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:generate": "turbo run db:generate --filter=@luciferus/db",
    "db:migrate": "turbo run db:migrate --filter=@luciferus/db",
    "db:seed": "turbo run db:seed --filter=@luciferus/db",
    "db:reset": "turbo run db:reset --filter=@luciferus/db",
    "setup": "bun install && bun run infra:up && bun run db:migrate && bun run db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.0",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3"
  }
}
