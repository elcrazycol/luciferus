{
  "name": "@luciferus/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/migrate.ts",
    "db:seed": "bun run src/seed.ts",
    "db:reset": "bun run src/reset.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@luciferus/config": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
